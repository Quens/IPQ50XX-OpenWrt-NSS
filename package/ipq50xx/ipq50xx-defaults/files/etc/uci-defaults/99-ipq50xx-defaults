#!/bin/sh
#
# Runs on the first boot of every image of this build, whatever the model,
# also after a keep-settings sysupgrade: only change what is still at its
# default.

. /lib/functions.sh

# LuCI's time zone list goes by the zone name; board.d can only set the
# POSIX string, and config_generate leaves the name at UTC
if [ "$(uci -q get system.@system[0].timezone)" = "CST-8" ] &&
   [ "$(uci -q get system.@system[0].zonename)" = "UTC" ]; then
	uci -q set system.@system[0].zonename='Asia/Shanghai'
	uci -q commit system
fi

# LuCI in Chinese, once: a language the user picks later stays
if [ -z "$(uci -q get luci.main.ipq50xx_defaults)" ] && uci -q get luci.main >/dev/null; then
	[ "$(uci -q get luci.main.lang)" = "auto" ] && uci -q set luci.main.lang='zh_cn'
	uci -q set luci.main.ipq50xx_defaults='1'
	uci -q commit luci
fi

# Downstream note: the original H3C-Magic-NSS script rewrites
# /etc/apk/repositories.d/distfeeds.list here, pointing the target feed at
# flyfish-go.github.io/H3C-Magic-NSS/<release>/packages.adb (or dropping the
# target feed when the image name does not match). That repository is built
# and signed for FlyFish's own release set; this image is built from this
# tree, so the block is intentionally dropped and the stock feed list is
# kept untouched.

exit 0
